<?xml version="1.0" encoding="utf-8"?>
<!-- Free-design widget background: a rounded, stroked gradient. Referenced as @drawable/widget_bg_gradient.
     Because it is baked into the layout XML (inflation time), it is fully valid in RemoteViews. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient android:angle="135"
        android:startColor="#1E3A8A"
        android:endColor="#0B1220"
        android:type="linear" />
    <corners android:radius="20dp" />
    <stroke android:width="1dp" android:color="#334155" />
</shape>
