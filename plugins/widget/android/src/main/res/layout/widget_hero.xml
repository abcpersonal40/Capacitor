<?xml version="1.0" encoding="utf-8"?>
<!-- Free-design home-screen widget. A developer can ship their own RemoteViews layout and reference
     it by name via WidgetConfig.layout (e.g. layout:'hero'). It only needs to declare the same ids
     the renderer fills: widget_root, widget_icon, widget_image, widget_value, widget_title,
     widget_subtitle, widget_progress, widget_button. RelativeLayout + ImageView + Button + gradient
     background are all valid inside RemoteViews. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_gradient"
    android:padding="18dp">

    <ImageView
        android:id="@+id/widget_image"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"
        android:contentDescription="@null"
        android:src="@drawable/widget_hero_badge"
        android:visibility="visible" />

    <TextView
        android:id="@+id/widget_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/widget_image"
        android:layout_centerVertical="true"
        android:layout_marginStart="8dp"
        android:textSize="20sp"
        android:visibility="gone"
        android:text="⚡" />

    <TextView
        android:id="@+id/widget_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/widget_icon"
        android:layout_centerVertical="true"
        android:textColor="#4FC3F7"
        android:textSize="56sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginStart="12dp"
        android:text="0" />

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_value"
        android:layout_toEndOf="@id/widget_image"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:textColor="#E2E8F0"
        android:textSize="15sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="NativeKit" />

    <TextView
        android:id="@+id/widget_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_title"
        android:layout_toEndOf="@id/widget_image"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_below="@id/widget_subtitle"
        android:layout_marginTop="12dp"
        android:max="100"
        android:progress="0"
        android:visibility="gone" />

    <Button
        android:id="@+id/widget_button"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_below="@id/widget_progress"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:background="@drawable/widget_btn_rounded"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:text="@string/nativekit_widget_open" />
</RelativeLayout>
