{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["bridge/**/*.ts", "capacitor.config.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "android", "ios", ".nativekit", "web-dist"]
}
